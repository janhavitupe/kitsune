# Copy to .env at the repo root and fill in. Never commit .env.

# Meta Model API (OpenAI-compatible)
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
WONDER_MODEL=muse-wonder-1.0
IMAGE_MODEL=muse-image-1.0
VOICE_MODEL=muse-voice-transcribe-1.0
SAM_MODEL=sam-3.1

# Open-weights endpoint (Baseten primary, Fireworks fallback)
OPENWEIGHTS_BASE_URL=
OPENWEIGHTS_API_KEY=
OPENWEIGHTS_MODEL=

# Backend
# Defaults to <repo>/data. A relative path is resolved from wherever uvicorn is started.
# DATA_DIR=
CORS_ORIGINS=http://localhost:5173
# 1 = serve only from ai_cache, never call models (demo safety)
AI_OFFLINE=0
# Optional shared password for the live link
DEMO_PASSWORD=
